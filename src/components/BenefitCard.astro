---
const { title, description, children } = Astro.props;
---

<article class="bg-white p-8 rounded-lg shadow-lg border border-gray-200">
  <div class="text-blue-800 mb-4">
    {children}
  </div>
  <h3 class="text-2xl font-bold mb-4 text-blue-900">{title}</h3>
  <p class="text-gray-700">{description}</p>
</article>
